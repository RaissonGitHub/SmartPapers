# Copie este arquivo para .env e preencha os valores.
# cp .env.example .env

# --- Banco de dados (PostgreSQL + pgvector) ---
POSTGRES_DB=smartpapers
POSTGRES_USER=smartpapers_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
# Gere uma chave com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# "True" em desenvolvimento, "False" em producao
DJANGO_DEBUG=True
# Lista separada por virgula (vazia em desenvolvimento = apenas localhost)
DJANGO_ALLOWED_HOSTS=
# URL do painel admin (altere para dificultar o acesso; o nginx proxy qualquer
# caminho, então pode usar o que quiser aqui)
DJANGO_ADMIN_URL=gestao-smartpapers/

# --- Cadastro ---
# "1" = cadastro publico com protecoes (senha forte, blocklist de username,
# rate limit por IP no registro). "0" = cadastro fechado.
REGISTRO_PUBLICO=1
# Bloqueio por IP apos tentativas falhas de login
AUTH_FALHAS_LIMITE=5
AUTH_JANELA_SEGUNDOS=900
AUTH_BLOQUEIO_SEGUNDOS=900
# Numero de proxies entre o cliente e o gunicorn. "1" com o nginx na frente
# (para rate limit e bloqueio por IP enxergarem o IP real do cliente).
DJANGO_NUM_PROXIES=1

# --- HTTPS / seguranca ---
# Origens do frontend que podem chamar a API (CORS/CSRF), separadas por virgula.
# Deixe as de producao, ex.: https://smartpapers.meudominio.com
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Cookies de sessao/CSRF apenas via HTTPS. Padrao: on quando DEBUG=False.
DJANGO_SECURE_COOKIES=
# Redireciona HTTP -> HTTPS. Padrao: on quando DEBUG=False.
DJANGO_SSL_REDIRECT=
# HSTS (0 desliga). Padrao: 31536000 quando DEBUG=False.
DJANGO_HSTS_SECONDS=

# --- Cache (cancelamento de requisicoes entre workers) ---
# Deixe vazio para LocMemCache (1 worker). Com varios workers do gunicorn,
# defina um Redis, ex.: redis://redis:6379/0
REDIS_URL=

# --- gunicorn (producao) ---
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=900

# Pre-carrega o modelo de embeddings (SPECTER2) no boot, evitando o cold start
# no primeiro chat. "1" ligado, "0" desligado.
PREAQUECER_EMBEDDINGS=1

# --- Coleta de artigos (OpenAlex) ---
# Chave gratuita em https://openalex.org/  (obrigatoria desde fev/2026)
OPENALEX_API_KEY=

# --- Provedor LLM ---
# "ollama" (local) ou "gemini" (nuvem)
LLM_PROVIDER=ollama
# Modelo padrao do Gemini
GEMINI_MODEL=gemini-3.8-flash
# Modelo padrao do Ollama
MODELO_OLLAMA=qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=120

# Habilita o servico Ollama (modelo local). Em servidores sem recursos
# (VPS fraca), deixe em "0" para usar apenas o Gemini: o frontend esconde a
# opcao Ollama e o backend recusa pedidos com provider "ollama".
OLLAMA_ENABLED=0

# --- Busca semantica ---
SIMILARIDADE_MIN=0
AREAS_CACHE_TTL=300

# --- Extração de secoes de PDF ---
PDF_TAM_SECAO=2000
PDF_MAX_SECOES=40
PDF_LOTE_SECOES=12
PDF_SECOES_MAX=6
PDF_SECOES_SIM_MIN=0.3
PDF_SECOES_BUSCA_MAX=4

# --- Limites do chat ---
MAX_MENSAGEM_CHARS=50000
MAX_PDF_BYTES=15728640