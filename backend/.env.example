# Copie este arquivo para .env e preencha os valores.
# cp .env.example .env

# --- Banco de dados (PostgreSQL + pgvector) ---
POSTGRES_DB=smartpapers
POSTGRES_USER=smartpapers_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
# Gere uma chave com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# "True" em desenvolvimento, "False" em produção
DJANGO_DEBUG=True
# Lista separada por vírgula (vazia em desenvolvimento = apenas localhost)
DJANGO_ALLOWED_HOSTS=
# URL do painel admin (altere para dificultar acesso)
DJANGO_ADMIN_URL=admin/

# Pré-carrega o modelo de embeddings (SPECTER2) no boot do runserver,
# evitando o cold start no primeiro chat. "1" ligado, "0" desligado.
PREAQUECER_EMBEDDINGS=1

# --- Coleta de artigos (OpenAlex) ---
# Chave gratuita em https://openalex.org/  (obrigatória desde fev/2026)
OPENALEX_API_KEY=

# --- Provedor LLM ---
# "ollama" (local) ou "gemini" (nuvem)
LLM_PROVIDER=ollama
# Modelo padrão do Gemini
GEMINI_MODEL=gemini-3.8-flash
# Modelo padrão do Ollama
MODELO_OLLAMA=qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=120

# Habilita o serviço Ollama (modelo local). Em servidores sem recursos
# (VPS fraca), deixe em "0" para usar apenas o Gemini: o frontend esconde a
# opção Ollama e o backend recusa pedidos com provider "ollama".
OLLAMA_ENABLED=0

# --- Busca semântica ---
SIMILARIDADE_MIN=0
AREAS_CACHE_TTL=300

# --- Extração de seções de PDF ---
PDF_TAM_SECAO=2000
PDF_MAX_SECOES=40
PDF_LOTE_SECOES=12
PDF_SECOES_MAX=6
PDF_SECOES_SIM_MIN=0.3
PDF_SECOES_BUSCA_MAX=4